{
  "id": "agents",
  "name": "Agents",
  "version": "0.1.0",
  "api": 1,
  "minUDeck": "0.9.32",
  "kind": "resident",
  "description": "Sessions of AI agents on a card: start one in a folder, see it work, answer its questions and permissions, continue any saved one. Runs your own Claude Code and Codex, and moves a conversation between them.",
  "author": "uDeck",
  "run": [
    "./agents"
  ],
  "permissions": {
    "exec": [
      "claude",
      "codex"
    ]
  },
  "window": {
    "defaultWidth": 6,
    "defaultHeight": 4,
    "minWidth": 3,
    "minHeight": 2
  },
  "settingGroups": [
    {
      "id": "context",
      "label": "Context",
      "preview": true
    },
    {
      "id": "sleep",
      "label": "Mac's sleep"
    }
  ],
  "settings": [
    {
      "key": "claude",
      "type": "string",
      "label": "claude to run (empty: the one your shell finds)",
      "default": ""
    },
    {
      "key": "codex",
      "type": "string",
      "label": "codex to run (empty: the one your shell finds)",
      "default": ""
    },
    {
      "key": "account_mode",
      "type": "enum",
      "default": "burnFirst",
      "label": "How Auto picks an account",
      "help": "For a new session, and when a session's account runs out of its limit.",
      "options": [
        {
          "value": "burnFirst",
          "label": "What would expire first"
        },
        {
          "value": "headroom",
          "label": "The most left"
        },
        {
          "value": "spareMain",
          "label": "Spare the main account"
        },
        {
          "value": "even",
          "label": "Evenly by sessions"
        }
      ]
    },
    {
      "key": "keep_awake",
      "type": "bool",
      "default": true,
      "label": "Keep the Mac awake while an agent works",
      "help": "The display still sleeps; a closed lid sleeps the Mac anyway.",
      "group": "sleep"
    },
    {
      "key": "name_chats",
      "type": "bool",
      "default": true,
      "label": "Make up names for chats",
      "help": "After the first answer the session's own agent names a chat with no name of its own: Haiku for Claude, Codex's model for Codex. A little of the subscription's limit. /rename in the field names one yourself."
    },
    {
      "key": "editor",
      "type": "enum",
      "default": "system",
      "label": "Open a file from the chat in",
      "help": "A path in an answer opens here at its line. ⌘-click shows it in Finder, ⌥-click in Quick Look.",
      "options": [
        {
          "value": "system",
          "label": "The Mac's choice for the file"
        },
        {
          "value": "vscode",
          "label": "Visual Studio Code"
        },
        {
          "value": "xcode",
          "label": "Xcode"
        },
        {
          "value": "cursor",
          "label": "Cursor"
        },
        {
          "value": "zed",
          "label": "Zed"
        }
      ]
    },
    {
      "key": "ctx_badge",
      "type": "enum",
      "default": "tokens",
      "label": "Shown as",
      "group": "context",
      "section": "The badge",
      "options": [
        {
          "value": "percent",
          "label": "25%"
        },
        {
          "value": "tokens",
          "label": "25% · 249k / 1M"
        },
        {
          "value": "pie",
          "label": "◔ 25%"
        },
        {
          "value": "strip",
          "label": "A strip under the line"
        },
        {
          "value": "none",
          "label": "Not shown"
        }
      ]
    },
    {
      "key": "ctx_tone",
      "type": "bool",
      "default": true,
      "label": "Coloured as it fills — yellow from 75%, red from 90%",
      "group": "context"
    },
    {
      "key": "ctx_details",
      "type": "enum",
      "default": "click",
      "label": "Where",
      "group": "context",
      "section": "Details",
      "options": [
        {
          "value": "click",
          "label": "On a click"
        },
        {
          "value": "line",
          "label": "Always, in a line"
        },
        {
          "value": "off",
          "label": "Nowhere"
        }
      ]
    },
    {
      "key": "ctx_parts",
      "type": "bool",
      "default": true,
      "label": "What it is made of",
      "group": "context"
    },
    {
      "key": "ctx_graph",
      "type": "bool",
      "default": true,
      "label": "How it grew",
      "group": "context"
    },
    {
      "key": "ctx_turns",
      "type": "bool",
      "default": true,
      "label": "Turns left",
      "group": "context"
    },
    {
      "key": "ctx_heavy",
      "type": "bool",
      "default": true,
      "label": "What takes the most",
      "group": "context"
    },
    {
      "key": "ctx_cache",
      "type": "bool",
      "default": true,
      "label": "The warm cache",
      "group": "context"
    },
    {
      "key": "ctx_week",
      "type": "bool",
      "default": true,
      "label": "Share of the week",
      "group": "context"
    },
    {
      "key": "ctx_cost",
      "type": "bool",
      "default": true,
      "label": "Cost and time",
      "group": "context"
    },
    {
      "key": "ctx_model",
      "type": "bool",
      "default": true,
      "label": "Model and effort",
      "group": "context"
    },
    {
      "key": "ctx_account",
      "type": "bool",
      "default": true,
      "label": "Account and its limit",
      "group": "context"
    },
    {
      "key": "ctx_auto",
      "type": "bool",
      "default": true,
      "label": "When it compacts",
      "group": "context"
    },
    {
      "key": "ctx_btn_compact",
      "type": "bool",
      "default": true,
      "label": "Compact now",
      "group": "context",
      "section": "Buttons"
    },
    {
      "key": "ctx_btn_hint",
      "type": "bool",
      "default": true,
      "label": "Compact with a hint…",
      "group": "context"
    },
    {
      "key": "ctx_btn_fresh",
      "type": "bool",
      "default": true,
      "label": "New chat with a summary",
      "group": "context"
    },
    {
      "key": "ctx_pause",
      "type": "bool",
      "default": true,
      "label": "Compact in the pause after a turn, not in the middle of one",
      "group": "context",
      "section": "Compaction"
    },
    {
      "key": "ctx_pause_at",
      "type": "int",
      "default": 70,
      "min": 40,
      "max": 95,
      "label": "…when fuller than, %",
      "group": "context"
    },
    {
      "key": "ctx_mark",
      "type": "bool",
      "default": true,
      "label": "Mark a compaction in the feed, with its summary",
      "group": "context"
    },
    {
      "key": "sleep_show",
      "type": "enum",
      "default": "icon",
      "label": "While an agent keeps the Mac awake",
      "group": "sleep",
      "options": [
        {
          "value": "icon",
          "label": "☕ in the card's line, the rest on a click"
        },
        {
          "value": "one",
          "label": "One line"
        },
        {
          "value": "two",
          "label": "Two lines"
        },
        {
          "value": "none",
          "label": "Not shown"
        }
      ]
    }
  ]
}
